<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Typography -->
    <style name="TextAppearance.QM.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.QM.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.QM.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.QM.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.QM.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!--
        Arabic ayah text. We rely on the system Arabic font fallback and apply a textLocale
        of "ar" so the platform routes glyph selection through the Arabic shaping engine. This
        deliberately avoids bundling a TTF as a binary asset.
    -->
    <style name="TextAppearance.QM.Arabic" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_arabic_default</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="TextAppearance.QM.Arabic.Large">
        <item name="android:textSize">@dimen/text_arabic_large</item>
    </style>

    <!-- Surfaces -->
    <style name="Widget.QM.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface_subtle</item>
        <item name="contentPadding">@dimen/card_horizontal_padding</item>
    </style>

    <style name="Widget.QM.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface_elevated</item>
        <item name="contentPadding">@dimen/card_horizontal_padding</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.QM.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <style name="Widget.QM.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <style name="Widget.QM.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <!-- BottomNavigationView -->
    <style name="Widget.QM.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.Material3.BottomNavigationView.ActiveIndicator</item>
    </style>
</resources>
