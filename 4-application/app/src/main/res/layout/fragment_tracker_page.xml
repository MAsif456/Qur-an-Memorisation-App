<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_default">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tracker_page_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:paddingVertical="@dimen/space_default" />

    <TextView
        android:id="@+id/tracker_page_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="@dimen/space_double"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone" />
</FrameLayout>
