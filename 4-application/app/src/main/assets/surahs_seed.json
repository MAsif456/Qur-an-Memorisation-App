  "ayahs": [
    {"surahNumber":1,"ayahNumber":1,"textArabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","textTranslation":"In the name of Allah, the Entirely Merciful, the Especially Merciful."},
    {"surahNumber":1,"ayahNumber":2,"textArabic":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","textTranslation":"All praise is due to Allah, Lord of the worlds."},
    {"surahNumber":1,"ayahNumber":3,"textArabic":"ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","textTranslation":"The Entirely Merciful, the Especially Merciful."},
    {"surahNumber":1,"ayahNumber":4,"textArabic":"مَٰلِكِ يَوْمِ ٱلدِّينِ","textTranslation":"Sovereign of the Day of Recompense."},
    {"surahNumber":1,"ayahNumber":5,"textArabic":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","textTranslation":"It is You we worship and You we ask for help."},
    {"surahNumber":1,"ayahNumber":6,"textArabic":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","textTranslation":"Guide us to the straight path."},
    {"surahNumber":1,"ayahNumber":7,"textArabic":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","textTranslation":"The path of those upon whom You have bestowed favour, not of those who have evoked anger or of those who are astray."},
    {"surahNumber":112,"ayahNumber":1,"textArabic":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","textTranslation":"Say, He is Allah, the One."},
    {"surahNumber":112,"ayahNumber":2,"textArabic":"ٱللَّهُ ٱلصَّمَدُ","textTranslation":"Allah, the Eternal Refuge."},
    {"surahNumber":112,"ayahNumber":3,"textArabic":"لَمْ يَلِدْ وَلَمْ يُولَدْ","textTranslation":"He neither begets nor is born."},
    {"surahNumber":112,"ayahNumber":4,"textArabic":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","textTranslation":"Nor is there to Him any equivalent."}
  ],
